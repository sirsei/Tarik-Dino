			return
		end

		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			listeningForKey = false
			applyMinimizeKeybind(input.KeyCode)
			if keybindLabel and typeof(keybindLabel.Set) == "function" then
				pcall(function()
					keybindLabel:Set("Minimize Keybind: " .. minimizeKeybind.Name)
				end)
			end
		end
	end)

	miscSection:Button({
		Name = "Toggle Minimize Sekarang",
		Callback = function()
			toggleUiMinimize()
		end,
	})
end

local charAddedConn = player.CharacterAdded:Connect(function()
	if autoFarmEnabled then
		farmState = "TELEPORT"
	end
	unblurAvatarInGuis()
end)

window:OnClose(function()
	autoFarmEnabled = false
	autoTapX2Enabled = false
	if charAddedConn then
		charAddedConn:Disconnect()
		charAddedConn = nil
	end
	if idledConn then
		idledConn:Disconnect()
		idledConn = nil
	end
	if trainBubbleConn then
		trainBubbleConn:Disconnect()
		trainBubbleConn = nil
	end
end)

window:SelectTab(mainTab)
