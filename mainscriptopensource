		if ok and Remotes then
			remotesRef = Remotes
			if Remotes.TrainBubble and Remotes.TrainBubbleHit then
				trainBubbleConn = Remotes.TrainBubble.OnClientEvent:Connect(function(bubbleId, _duration)
