local function findThrowElements()
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Name ~= "SeiScriptMacLib" then
			local layer = gui:FindFirstChild("ThrowLayer", true)
			if layer then
				local meter = layer:FindFirstChild("Meter", true)
				local bar = meter and meter:FindFirstChild("Bar", true)
				local slider = meter and meter:FindFirstChild("Slider", true)
				local perfectBand = bar and bar:FindFirstChild("PerfectBand", true)
				local prompt = layer:FindFirstChild("Prompt", true)
				local reveal = layer:FindFirstChild("Reveal", true)
				local roller = layer:FindFirstChild("Roller", true)
				local stamp = layer:FindFirstChild("Stamp", true)
				local continueObj = reveal and reveal:FindFirstChild("Continue", true)
					or layer:FindFirstChild("Continue", true)

				if meter and slider then
					return meter, slider, perfectBand, prompt, reveal, continueObj, roller, stamp
				end
			end
		end
	end
	return nil
end

local function isSliderInTopZone(slider)
	local sliderY = slider.Position.Y.Scale
	return sliderY <= TOP_ZONE_MAX_Y_SCALE
end

local function sendScreenClick(xRatio, yRatio)
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local x = vp.X * (xRatio or 0.5)
	local y = vp.Y * (yRatio or 0.5)

	VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
	task.wait(0.02)
	VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function isGuiActuallyVisible(guiObj)
	local current = guiObj
	while current and current ~= playerGui do
		if current:IsA("ScreenGui") or current:IsA("BillboardGui") then
			if not current.Enabled then
				return false
			end
		elseif current:IsA("GuiObject") then
			if not current.Visible then
				return false
			end
		end
		current = current.Parent
	end
	return true
end

local function findVisibleX2HitButtons()
	local buttons = {}
	local padHud = playerGui:FindFirstChild("PAD_HUD")
	local root = padHud and padHud:FindFirstChild("Root")
	local x2Target = root and root:FindFirstChild("X2Target")

	if x2Target and x2Target:IsA("GuiObject") and isGuiActuallyVisible(x2Target) then
		local hitBtn = x2Target:FindFirstChild("Hit")
		if hitBtn and hitBtn:IsA("GuiButton") and isGuiActuallyVisible(hitBtn) then
			table.insert(buttons, hitBtn)
		elseif x2Target:IsA("GuiButton") then
			table.insert(buttons, x2Target)
		end
	end

	return buttons
end

local tappedRecently = setmetatable({}, { __mode = "k" })
local tappingInProgress = false

local function fireButtonDirectly(btn)
	if typeof(firesignal) == "function" then
		pcall(firesignal, btn.Activated)
		pcall(firesignal, btn.MouseButton1Click)
		return true
	end

	if typeof(getconnections) == "function" then
		local fired = false
		for _, signalName in ipairs({ "Activated", "MouseButton1Click" }) do
			local ok, conns = pcall(getconnections, btn[signalName])
			if ok and type(conns) == "table" then
				for _, conn in ipairs(conns) do
					if conn.Function then
						pcall(conn.Function)
						fired = true
					end
				end
			end
		end
		return fired
	end

	return false
end

local function tapGuiButton(btn)
	if tappingInProgress then
		return
	end

	local now = os.clock()
	if now - lastX2TapTime < X2_TAP_COOLDOWN then
		return
	end
	if tappedRecently[btn] and (now - tappedRecently[btn]) < 0.12 then
		return
	end

	tappingInProgress = true
	lastX2TapTime = now
	tappedRecently[btn] = now

	task.spawn(function()
		local fired = fireButtonDirectly(btn)
		if not fired then
			local pos = btn.AbsolutePosition
			local size = btn.AbsoluteSize
			if size.X > 0 and size.Y > 0 then
				local x = pos.X + (size.X * 0.5)
				local y = pos.Y + (size.Y * 0.5)
				local padHud = btn:FindFirstAncestorOfClass("ScreenGui")
				if padHud and not padHud.IgnoreGuiInset then
					y = y + GuiService:GetGuiInset().Y
				end

				VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
				task.wait(0.01)
				VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
			end
		end
		tappingInProgress = false
	end)
end

-- ==========================================
-- LOOP AUTOFARM, AUTO X2 & AUTO CLAIM GIFT
-- ==========================================
local window -- dideklarasikan di bawah setelah MacLib Window dibuat

local function startAutoFarmLoop()
	if farmLoopRunning then
		return
	end
	farmLoopRunning = true
	farmState = "TELEPORT"

	task.spawn(function()
		local stateEnteredAt = os.clock()
		local continueEnteredAt = 0

		local function setFarmState(nextState)
			farmState = nextState
			stateEnteredAt = os.clock()
			if nextState == "CONTINUE" then
				continueEnteredAt = os.clock()
			else
				continueEnteredAt = 0
			end
		end

		while autoFarmEnabled do
			RunService.RenderStepped:Wait()
			if not autoFarmEnabled then
				break
			end

			local now = os.clock()

			if (now - stateEnteredAt) >= STATE_STUCK_TIMEOUT then
				setFarmState("TELEPORT")
			end

			local meter, slider, _, prompt, reveal, continueObj, roller, stamp = findThrowElements()
			local isContinueVisible = continueObj
				and continueObj.Visible
				and (continueObj.TextTransparency or 0) < 0.92
			local isRevealVisible = reveal and reveal.Visible
			local isRollerVisible = roller and roller.Visible
			local isStampVisible = stamp and stamp.Visible and (stamp.TextTransparency or 0) < 0.92
			local isMeterVisible = meter and meter.Visible

			if farmState == "TELEPORT" then
				if isContinueVisible then
					if (now - lastContinueTime) >= CONTINUE_COOLDOWN then
						lastContinueTime = now
						pcall(sendScreenClick, 0.5, 0.85)
						task.wait(POST_CONTINUE_WAIT)
					end
					continue
				end

				local pad = getThrowPadObject()
				local ok = false
				if pad then
					local success, result = pcall(performCleanTeleport, pad)
					ok = success and result == true
				end

				if ok then
					task.wait(POST_TELEPORT_WAIT)
					setFarmState("THROW")
				else
					task.wait(0.4)
				end

			elseif farmState == "THROW" then
				if isContinueVisible then
					setFarmState("CONTINUE")
					continue
				end

				if not meter or not slider then
					continue
				end

				if isMeterVisible and (not prompt or prompt.Visible) then
					if isSliderInTopZone(slider) then
						if (now - lastThrowTime) >= THROW_COOLDOWN then
							lastThrowTime = now
							pcall(sendScreenClick, 0.5, 0.5)
							setFarmState("CONTINUE")
						end
					end
				end

			elseif farmState == "CONTINUE" then
				if continueEnteredAt == 0 then
					continueEnteredAt = now
				end

				if isContinueVisible then
					if (now - lastContinueTime) >= CONTINUE_COOLDOWN then
						lastContinueTime = now
						pcall(sendScreenClick, 0.5, 0.85)
						task.wait(0.25)
					end
				elseif not isRevealVisible and not isRollerVisible and not isStampVisible and not isMeterVisible then
					task.wait(POST_CONTINUE_WAIT)
					setFarmState("TELEPORT")
				elseif (now - continueEnteredAt) >= CONTINUE_WATCHDOG_TIME then
					pcall(sendScreenClick, 0.5, 0.85)
					task.wait(POST_CONTINUE_WAIT)
					setFarmState("TELEPORT")
				end
			end
		end

		farmState = "TELEPORT"
		farmLoopRunning = false
	end)
end

local function startAutoX2Loop()
	if x2LoopRunning then
		return
	end
	x2LoopRunning = true

	task.spawn(function()
		while autoTapX2Enabled do
			local hitButtons = findVisibleX2HitButtons()
			for _, hitBtn in ipairs(hitButtons) do
				if not autoTapX2Enabled then
					break
				end
				pcall(tapGuiButton, hitBtn)
			end
			task.wait(X2_SCAN_INTERVAL)
		end
		x2LoopRunning = false
	end)
end

local function startAutoClaimGiftLoop()
	if giftLoopRunning then
		return
	end
	giftLoopRunning = true

	task.spawn(function()
		pcall(ensureSharedModules)
		while autoClaimGiftEnabled do
			pcall(tryClaimReadyGifts)
			task.wait(GIFT_SCAN_INTERVAL)
		end
		giftLoopRunning = false
	end)
end

-- Loop ringan: hanya satu thread, tidur di antara panggilan,
-- dan InvokeServer ditunggu selesai dulu sehingga request tidak menumpuk.
local function startAutoEquipBestLoop()
	if equipBestLoopRunning then
		return
	end
	equipBestLoopRunning = true

	task.spawn(function()
		local dinoAction = nil

		while autoEquipBestEnabled do
			if not dinoAction or not dinoAction.Parent then
				local remotes = ReplicatedStorage:FindFirstChild("Remotes")
				dinoAction = remotes and remotes:FindFirstChild("DinoAction")
			end

			if dinoAction then
				local ok, err = pcall(function()
					return dinoAction:InvokeServer("EquipBest")
				end)
				if not ok then
					warn("[SeiScript] Auto Equip Best gagal: " .. tostring(err))
				end
			end

			local nextRun = os.clock() + EQUIP_BEST_INTERVAL
			while autoEquipBestEnabled and os.clock() < nextRun do
				task.wait(0.25)
			end
		end

		equipBestLoopRunning = false
	end)
end

