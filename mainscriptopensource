-- HOOK REMOTES TRAINING (AUTO HIT BUBBLE X2) & GIFTS
-- ==========================================
local trainBubbleConn = nil
local remotesRef = nil
local giftsConfigRef = nil
local giftClaimBusy = false

local function ensureSharedModules()
	local shared = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:WaitForChild("Shared", 10)
	if not shared then
		return nil, nil
	end

	if not remotesRef then
		local remotesModule = shared:FindFirstChild("Remotes")
		if remotesModule then
			local ok, Remotes = pcall(require, remotesModule)
			if ok and type(Remotes) == "table" then
				remotesRef = Remotes
			end
		end
	end

	if not giftsConfigRef then
		local configModule = shared:FindFirstChild("Config")
		if configModule then
			local ok, Config = pcall(require, configModule)
			if ok and type(Config) == "table" and type(Config.Gifts) == "table" then
				giftsConfigRef = Config.Gifts
			end
		end
	end

	return remotesRef, giftsConfigRef
end

local function setupTrainBubbleHook()
	if trainBubbleConn then
		return
	end

	task.spawn(function()
		local Remotes = ensureSharedModules()
		if Remotes and Remotes.TrainBubble and Remotes.TrainBubbleHit then
			trainBubbleConn = Remotes.TrainBubble.OnClientEvent:Connect(function(bubbleId, _duration)
				if not autoTapX2Enabled or not bubbleId then
					return
				end
				task.wait(0.03)
				if autoTapX2Enabled then
					pcall(function()
						Remotes.TrainBubbleHit:FireServer(bubbleId)
					end)
				end
			end)
		end
	end)
end

setupTrainBubbleHook()

local function getGiftElapsed()
	local giftStart = player:GetAttribute("GiftStart")
	if type(giftStart) ~= "number" then
		return -1
	end
	return workspace:GetServerTimeNow() - giftStart
end

local function getClaimedGiftsSet()
	local claimed = {}
	local rawClaimed = player:GetAttribute("GiftsClaimed")
	if type(rawClaimed) == "string" then
		for _, token in string.split(rawClaimed, ",") do
			local idx = tonumber(token)
			if idx then
				claimed[idx] = true
			end
		end
	end
	return claimed
end

local function tryClaimReadyGifts()
	if giftClaimBusy then
		return
	end

	local Remotes, Gifts = ensureSharedModules()
	if not Remotes or type(Remotes.ClaimGift) ~= "userdata" and type(Remotes.ClaimGift) ~= "function" then
		return
	end
	if type(Gifts) ~= "table" then
		return
	end

	local elapsed = getGiftElapsed()
	if elapsed < 0 then
		return
	end

	local claimed = getClaimedGiftsSet()
	giftClaimBusy = true

	for index, giftData in pairs(Gifts) do
		if not autoClaimGiftEnabled then
			break
		end

		local giftIndex = tonumber(index) or index
		local requiredTime = type(giftData) == "table" and giftData.At or nil

		if giftIndex and type(requiredTime) == "number" and (not claimed[giftIndex]) and elapsed >= requiredTime then
			local now = os.clock()
			if (now - lastGiftClaimTime) < GIFT_CLAIM_COOLDOWN then
				task.wait(GIFT_CLAIM_COOLDOWN - (now - lastGiftClaimTime))
			end

			if not autoClaimGiftEnabled then
				break
			end

			lastGiftClaimTime = os.clock()
			local ok, result = pcall(function()
				return Remotes.ClaimGift:InvokeServer(giftIndex)
			end)

			if ok and type(result) == "table" and result.Ok then
				claimed[giftIndex] = true
			end

			task.wait(0.15)
		end
	end

	giftClaimBusy = false
end

