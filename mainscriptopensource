-- Load MacLib dari mainUI dengan fallback aman
local function fetchSource(url)
	if typeof(game.HttpGet) == "function" then
		local ok, res = pcall(function()
			return game:HttpGet(url, true)
		end)
		if ok and type(res) == "string" and #res > 0 then
			return res
		end
	end

	local reqFn = (syn and syn.request) or request or http_request or (http and http.request)
	if type(reqFn) == "function" then
		local ok, res = pcall(reqFn, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then
			return res.Body
		end
	end

	return nil
end

local function compileLua(code)
	local loader = loadstring or load
	if type(loader) ~= "function" then
		return nil, "loadstring/load tidak tersedia di executor ini."
	end

	local chunk, err = loader(code)
	if type(chunk) == "function" then
		return chunk, nil
	end

	if tostring(err):find("got <eof>") then
		local patched = code
		for i = 1, 10 do
			patched = patched .. "\nend"
			local retryChunk, retryErr = loader(patched)
			if type(retryChunk) == "function" then
				warn(("[MacLib] mainUI terpotong di EOF, menambahkan %d 'end' darurat."):format(i))
				return retryChunk, nil
			end
			err = retryErr
		end
	end

	return nil, err
end

local rawSource = fetchSource(MACLIB_URL)
assert(rawSource, "[MacLib] Gagal mengambil kode dari URL: " .. MACLIB_URL)

local chunk, compileErr = compileLua(rawSource)
assert(type(chunk) == "function", "[MacLib] Gagal compile kode: " .. tostring(compileErr))

