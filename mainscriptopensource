local function getTargetCFrame(character, targetObj)
	if not targetObj then
		return nil
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	local footOffset = 3
	if humanoid and hrp then
		if humanoid.RigType == Enum.HumanoidRigType.R15 then
			footOffset = humanoid.HipHeight + (hrp.Size.Y * 0.5)
		else
			footOffset = (humanoid.HipHeight > 0 and humanoid.HipHeight or 2) + (hrp.Size.Y * 0.5) + 0.5
		end
	end

	if targetObj:IsA("BasePart") then
		local topSurfacePos = targetObj.CFrame:PointToWorldSpace(Vector3.new(0, targetObj.Size.Y * 0.5, 0))
		local _, yRot, _ = targetObj.CFrame:ToOrientation()
		return CFrame.new(topSurfacePos + Vector3.new(0, footOffset + 0.2, 0)) * CFrame.Angles(0, yRot, 0)
	end

	if targetObj:IsA("Model") then
		local cf, size = targetObj:GetBoundingBox()
		local topSurfacePos = cf:PointToWorldSpace(Vector3.new(0, size.Y * 0.5, 0))
		local _, yRot, _ = cf:ToOrientation()
		return CFrame.new(topSurfacePos + Vector3.new(0, footOffset + 0.2, 0)) * CFrame.Angles(0, yRot, 0)
	end

	return nil
end

