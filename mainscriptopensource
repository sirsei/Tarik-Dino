local function getPlayerAvatarImage()
	local ok, thumb = pcall(function()
		return Players:GetUserThumbnailAsync(
			player.UserId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size420x420
		)
	end)
	if ok and type(thumb) == "string" and #thumb > 0 then
		return thumb
	end
	return ("rbxthumb://type=AvatarHeadShot&id=%d&w=420&h=420"):format(player.UserId)
end

local function unblurAvatarInGuis()
	local clearAvatar = getPlayerAvatarImage()
	local roots = { playerGui }

	local coreGui = (cloneref and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui")
	if coreGui then
		table.insert(roots, coreGui)
	end
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			table.insert(roots, hui)
		end
	end

	for _, root in ipairs(roots) do
		local ok, desc = pcall(function()
			return root:GetDescendants()
		end)
		if ok and type(desc) == "table" then
			for _, obj in ipairs(desc) do
				if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj.Image == BLURRED_AVATAR_ASSET then
					obj.Image = clearAvatar
					if obj.ImageTransparency > 0.25 then
						obj.ImageTransparency = 0
					end
				end
			end
		end
	end
end

local function setUiMinimized(state)
	uiMinimized = not not state

	if window then
		if uiMinimized and typeof(window.Minimize) == "function" then
			local ok = pcall(function()
				window:Minimize()
			end)
			if ok then
				return
			end
		elseif (not uiMinimized) and typeof(window.Maximize) == "function" then
			local ok = pcall(function()
				window:Maximize()
			end)
			if ok then
				return
			end
		end
	end

	-- Fallback jika MacLib tidak mengekspos Minimize/Maximize langsung
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") then
			local base = gui:FindFirstChild("Base", true)
			if base and base:IsA("GuiObject") then
				base.Visible = not uiMinimized
				return
			end
		end
	end
end

local function toggleUiMinimize()
	setUiMinimized(not uiMinimized)
end

