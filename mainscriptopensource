local function applyMinimizeKeybind(newKey)
	if typeof(newKey) ~= "EnumItem" or newKey.EnumType ~= Enum.KeyCode then
		return
	end
	if newKey == Enum.KeyCode.Unknown or newKey == window:GetMinimizeKeybind() then
		return
	end

	if window:SetMinimizeKeybind(newKey) then
		minimizeKeybind = newKey
		notifyUser("SeiScript", "Keybind minimize diubah ke: " .. newKey.Name)
	end
end

miscSection:Keybind({
	Name = "Minimize Keybind",
	Default = minimizeKeybind,
	-- onBinded dipanggil saat tombol baru dipasang.
	-- Minimize/maximize sendiri sudah diurus oleh MacLib.
	onBinded = applyMinimizeKeybind,
}, "MinimizeKeybind")

