local function applyMinimizeKeybind(newKey)
	if typeof(newKey) == "EnumItem" and newKey.EnumType == Enum.KeyCode then
		minimizeKeybind = newKey
		if window and typeof(window.SetKeybind) == "function" then
			pcall(function()
				window:SetKeybind(newKey)
			end)
		elseif window and type(window.Settings) == "table" then
			window.Settings.Keybind = newKey
		end
		notifyUser("SeiScript", "Keybind minimize diubah ke: " .. newKey.Name)
	end
end

